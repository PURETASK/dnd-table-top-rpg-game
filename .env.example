# Postgres connection (Prisma). Use a local Postgres or a hosted one (e.g. Supabase).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/realm_of_nexus?schema=public"

# Model provider for VERDAX. The turn engine calls an Anthropic Claude model.
# Use the latest capable model id for the AI Dungeon Master.
ANTHROPIC_API_KEY="sk-ant-..."
VERDAX_MODEL="claude-opus-4-8"

# Optional: cap turn cost / tokens
VERDAX_MAX_OUTPUT_TOKENS="4096"
